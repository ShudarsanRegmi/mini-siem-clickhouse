# ==============================================================================
# Mini SIEM Environment Configuration Template
# COPY TO .env AND POPULATE WITH SECURE PASSWORDS BEFORE STARTING SERVICES
# DO NOT COMMIT THE ACTUAL .env FILE
# ==============================================================================

# ClickHouse Administration
CLICKHOUSE_ADMIN_USER=default
CLICKHOUSE_ADMIN_PASSWORD=change_this_admin_password_in_prod

# ClickHouse Least-Privilege Role Accounts
# Ingestion User (INSERT on siem.raw_telemetry, siem.posture_findings)
CLICKHOUSE_INGEST_USER=siem_ingest
CLICKHOUSE_INGEST_PASSWORD=change_this_ingest_password

# Detection Engine User (SELECT on siem.raw_telemetry, INSERT on siem.security_alerts)
CLICKHOUSE_DETECTOR_USER=siem_detector
CLICKHOUSE_DETECTOR_PASSWORD=change_this_detector_password

# Grafana Read-Only User (SELECT ONLY on siem.*)
CLICKHOUSE_GRAFANA_USER=siem_grafana
CLICKHOUSE_GRAFANA_PASSWORD=change_this_grafana_password

# ClickHouse Connection Details
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_DB=siem

# Grafana Administration
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_this_grafana_admin_password

# GitHub Webhook Security
# Shared secret used to cryptographically verify X-Hub-Signature-256 HMAC
GITHUB_WEBHOOK_SECRET=change_this_github_webhook_hmac_secret

# Ingestion API Shared Bearer Token (Authentication for agent push endpoints)
INGESTION_BEARER_TOKEN=change_this_ingestion_api_bearer_token
